<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ TOOL_NAME }} — Tool Detail — INTERPOLATIONS</title>
    <meta name="description" content="{{ META_DESCRIPTION }}" />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#0736C4" />

    <!-- Favicons (shared) -->
    <link rel="icon" type="image/png" sizes="32x32" href="../../interpolations-favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="../../interpolations-favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="../../interpolations-apple-touch-icon.png" />
    <link rel="icon" href="../../interpolations-favicon.png" />

    <!-- Fonts & styles -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@300&family=Manrope:wght@300;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="../styles.css" />
  </head>
  <body>
    <main class="detail" aria-labelledby="detail-title">
      <button class="detail__close" aria-label="Close detail" onclick="window.location.href='../index.html'">×</button>

      <div class="detail__wrap">
        <!-- Media (left) -->
        <section class="detail__media" aria-label="Visual preview">
          <div class="detail__media__inner">
            <img
              class="detail__media-bg"
              src="{{ DETAIL_BACKGROUND }}"
              alt="{{ TOOL_NAME }} background"
              decoding="async"
              loading="eager"
            />
            {{ MEDIA_LOGO }}
            <div class="detail__overlay" aria-hidden="true"></div>
          </div>
        </section>

        <!-- Content (right) -->
        <section class="detail__body">
          <header class="detail__head">
            <h1 id="detail-title" class="detail__title">{{ TOOL_NAME }}</h1>
            <p class="detail__desc">{{ SHORT_DESCRIPTION }}</p>
          </header>

          <hr class="detail__divider" />

          <ul class="detail__features">
{{ FEATURE_LIST }}
          </ul>

          <div class="detail__cta-row">
            <a class="detail__cta" href="{{ TOOL_URL }}" target="_blank" rel="noopener">{{ TOOL_DOMAIN }}</a>

            <div class="detail__recommend" aria-label="Recommendation">
              <div class="detail__prompt">Would you<br />recommend?</div>
              <div class="detail__btns">
                <button class="detail__btn" type="button">Yes</button>
                <button class="detail__btn" type="button">No</button>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>
  </body>
  </html>

